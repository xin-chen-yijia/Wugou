<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:TextField picking-mode="Ignore" label="版本：" value="1" text="1" name="VersionInput" style="height: 30px; width: 100%; margin-left: 0; margin-right: 0; align-self: auto; -unity-text-align: middle-left; padding-top: 0; padding-left: 5px; padding-right: 5px; align-items: center;" />
    <ui:TextField picking-mode="Ignore" label="MAC：" value="00:00:00:00:00:00" text="00:00:00:00:00:00" name="MACInput" style="margin-left: 0; margin-right: 0; width: 100%; height: 30px; padding-left: 5px; padding-right: 5px; align-items: center;" />
    <ui:GroupBox style="flex-direction: row; justify-content: flex-start; margin-left: 0; margin-right: 0; margin-top: 2px; margin-bottom: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; width: 100%; height: 30px; align-items: center;">
        <ui:TextField picking-mode="Ignore" label="有效期：" value="1" text="1" name="ValidTimeInput" style="width: 80%; height: 30px; margin-left: 0; margin-right: 0; margin-bottom: 0; margin-top: 0; padding-left: 5px; align-items: center;" />
        <ui:Label text="月" display-tooltip-when-elided="true" style="width: 30px;" />
    </ui:GroupBox>
    <ui:GroupBox style="flex-direction: row; width: 100%; height: 30px; align-self: auto; margin-right: 0; margin-left: 0; align-items: center; padding-left: 0; margin-top: 2px;">
        <ui:TextField picking-mode="Ignore" label="输出目录：" name="OutputInput" style="width: 80%; margin-right: 0; margin-left: 0; padding-left: 5px; height: 30px; align-items: center;" />
        <ui:Button text="浏览" display-tooltip-when-elided="true" name="BrowserButton" style="height: 20px; width: 60px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
    </ui:GroupBox>
    <ui:Button text="生成" display-tooltip-when-elided="true" name="GenButton" style="height: 30px; margin-top: 30px;" />
</ui:UXML>
